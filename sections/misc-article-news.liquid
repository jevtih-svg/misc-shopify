{%- comment -%}
  MISC news article single — boxed reading column. templates/article.json.
{%- endcomment -%}
{{ 'misc-journal.css' | asset_url | stylesheet_tag }}

<div class="misc-jx">
  <div class="backbar"><div class="page"><div class="wrap"><div class="backbar__in">
    <a class="backbar__link" href="{{ blog.url }}">← Back to {{ blog.title }}</a>
    <span class="backbar__kicker">{{ blog.title }}</span>
  </div></div></div></div>

  <div class="page"><div class="wrap">
    <article class="article__in">
      {%- if article.tags.size > 0 -%}<span class="article__cat">{{ article.tags.first }}</span>{%- endif -%}
      <h1 class="article__title">{{ article.title }}</h1>
      <div class="article__meta">{{ article.published_at | date: '%d · %m · %Y' }}{% if article.author != blank %} — {{ article.author }}{% endif %}</div>
      {%- if article.image -%}
        <div class="article__img"><img src="{{ article.image | image_url: width: 1600 }}" alt="{{ article.image.alt | escape }}" width="1600"></div>
      {%- else -%}
        <div class="article__rule"></div>
      {%- endif -%}
      <div class="article__body">{{ article.content }}</div>
    </article>
  </div></div>
</div>

{% schema %}
{ "name": "MISC Article (news)", "settings": [] }
{% endschema %}
