{%- comment -%}
  ============================================================
  MISC brand page (v3) — fully block-composed
  ------------------------------------------------------------
  Same editing model as the hero slider: every element is a
  block you add with +, remove, and drag to reorder. No hidden
  rules, no long settings form.

  Block types (add / remove / reorder in the Theme Editor):
    - heading : eyebrow + brand name + lowercase toggle
    - fact    : a spec cell (label + value); sit several in a row
    - text    : rich text; Width = Full / Half
    - image   : photo; Width = Full / Half / Third (explicit, was
                the old hidden "first image is the hero" rule)
    - footer  : represented-by + website strip

  Blocks render top to bottom in the ink line-grid (6-col).
  Width controls the span (full=6, half=3, third=2); heading,
  fact and footer have fixed spans. Only divider weight + padding
  are section settings.

  CSS: assets/misc-brand-page.css
  Used by: templates/page.misc-*.json (per-brand)
  ============================================================
{%- endcomment -%}

{{ 'misc-brand-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign rule = section.settings.rule_weight | default: 3
-%}

<section
  class="misc-brand-page"
  style="--misc-brand-rule: {{ rule }}px; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="misc-brand-page__grid">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'heading' -%}
          <header class="misc-brand-page__cell misc-brand-page__name" style="grid-column: span 6;" {{ block.shopify_attributes }}>
            {%- if block.settings.eyebrow != blank -%}
              <p class="misc-brand-page__eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            <h1 class="misc-brand-page__title{% if block.settings.force_lowercase %} misc-brand-page__title--lower{% endif %}">{{ block.settings.heading | default: 'Brand' }}</h1>
          </header>

        {%- when 'fact' -%}
          <div class="misc-brand-page__cell misc-brand-page__meta" style="grid-column: span 2;" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <p class="misc-brand-page__eyebrow">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.value != blank -%}
              <p class="misc-brand-page__meta-value">{{ block.settings.value }}</p>
            {%- endif -%}
          </div>

        {%- when 'text' -%}
          {%- assign span = 3 -%}
          {%- if block.settings.width == 'full' -%}{%- assign span = 6 -%}{%- endif -%}
          <div class="misc-brand-page__cell misc-brand-page__text" style="grid-column: span {{ span }};" {{ block.shopify_attributes }}>
            <div class="misc-brand-page__prose">{{ block.settings.text }}</div>
          </div>

        {%- when 'image' -%}
          {%- assign span = 3 -%}
          {%- assign wclass = 'half' -%}
          {%- if block.settings.width == 'full' -%}{%- assign span = 6 -%}{%- assign wclass = 'full' -%}{%- endif -%}
          {%- if block.settings.width == 'third' -%}{%- assign span = 2 -%}{%- assign wclass = 'third' -%}{%- endif -%}
          {%- assign alt_text = block.settings.title | default: 'Brand image' -%}
          <figure class="misc-brand-page__cell misc-brand-page__media misc-brand-page__media--{{ wclass }}" style="grid-column: span {{ span }};" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 1000, 1400', sizes: '(max-width: 900px) 100vw, 50vw', alt: alt_text }}
            {%- elsif block.settings.image_url != blank -%}
              <img src="{{ block.settings.image_url }}" alt="{{ alt_text | escape }}" loading="lazy">
            {%- endif -%}
          </figure>

        {%- when 'shop' -%}
          <div class="misc-brand-page__cell misc-brand-page__shop" style="grid-column: span 6;" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="misc-brand-page__shop-btn" href="{{ block.settings.link }}">
                {{ block.settings.label | default: 'Shop the collection' }}
                <span class="misc-brand-page__shop-arrow" aria-hidden="true">&rarr;</span>
              </a>
            {%- endif -%}
          </div>

        {%- when 'footer' -%}
          <div class="misc-brand-page__cell misc-brand-page__foot" style="grid-column: span 6;" {{ block.shopify_attributes }}>
            <div class="misc-brand-page__foot-cell">
              {%- if block.settings.represented_label != blank -%}
                <p class="misc-brand-page__eyebrow">{{ block.settings.represented_label }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <p class="misc-brand-page__foot-org">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.represented_region != blank -%}
                <p class="misc-brand-page__foot-region">{{ block.settings.represented_region }}</p>
              {%- endif -%}
            </div>
            <div class="misc-brand-page__foot-cell">
              {%- if block.settings.discover_label != blank -%}
                <p class="misc-brand-page__eyebrow">{{ block.settings.discover_label }}</p>
              {%- endif -%}
              {%- if block.settings.website_label != blank or block.settings.website_url != blank -%}
                <a class="misc-brand-page__foot-link" href="{{ block.settings.website_url | default: '#' }}" target="_blank" rel="noopener">
                  {{ block.settings.website_label | default: 'Visit website' }}
                  <span class="misc-brand-page__foot-arrow" aria-hidden="true">&#8599;</span>
                </a>
              {%- endif -%}
            </div>
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "MISC Brand Page",
  "tag": "section",
  "class": "misc-brand-page-section",
  "max_blocks": 50,
  "settings": [
    { "type": "header", "content": "Global styling" },
    { "type": "range", "id": "rule_weight", "label": "Divider thickness", "min": 1, "max": 6, "step": 1, "unit": "px", "default": 3 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Brand name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Brand" },
        { "type": "text", "id": "heading", "label": "Brand name", "default": "hibi" },
        { "type": "checkbox", "id": "force_lowercase", "label": "Force lowercase", "default": true }
      ]
    },
    {
      "type": "fact",
      "name": "Spec fact",
      "settings": [
        { "type": "text", "id": "title", "label": "Label", "default": "Category" },
        { "type": "text", "id": "value", "label": "Value", "default": "Incense & design stationery" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "options": [
            { "value": "full", "label": "Full width" },
            { "value": "half", "label": "Half (two per row)" }
          ],
          "default": "half"
        },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Body text.</p>" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "options": [
            { "value": "full", "label": "Full width" },
            { "value": "half", "label": "Half (two per row)" },
            { "value": "third", "label": "Third (three per row)" }
          ],
          "default": "half"
        },
        { "type": "image_picker", "id": "image", "label": "Image (Shopify Files)" },
        { "type": "url", "id": "image_url", "label": "External image URL (fallback)" },
        { "type": "text", "id": "title", "label": "Alt text" }
      ]
    },
    {
      "type": "shop",
      "name": "Shop button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "Shop the collection" },
        { "type": "url", "id": "link", "label": "Link (filtered catalogue)" }
      ]
    },
    {
      "type": "footer",
      "name": "Footer",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "represented_label", "label": "Left label", "default": "Represented by" },
        { "type": "text", "id": "title", "label": "Representing company", "default": "MISC Distribution" },
        { "type": "text", "id": "represented_region", "label": "Territories", "default": "Netherlands & Germany" },
        { "type": "text", "id": "discover_label", "label": "Right label", "default": "Discover more" },
        { "type": "text", "id": "website_label", "label": "Website link label" },
        { "type": "url", "id": "website_url", "label": "Website link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MISC Brand Page",
      "blocks": [
        { "type": "heading" },
        { "type": "fact" },
        { "type": "fact" },
        { "type": "fact" },
        { "type": "text" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "shop" },
        { "type": "footer" }
      ]
    }
  ]
}
{% endschema %}
