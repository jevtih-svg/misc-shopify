{%- comment -%}
  ============================================================
  MISC Exhibition single — renders an `exhibition` metaobject.
  Info left / image right, boxed. Used by
  templates/metaobject.exhibition.json (the metaobject page).
  ============================================================
{%- endcomment -%}
{{ 'misc-journal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ex = metaobject
  assign sd = ex.start_date.value
  assign ed = ex.end_date.value | default: sd
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign start_ts = sd | date: '%s' | plus: 0
  assign end_ts = ed | date: '%s' | plus: 0
  if end_ts < now_ts
    assign status = 'past'
  elsif start_ts <= now_ts
    assign status = 'now'
  else
    assign status = 'upcoming'
  endif
  assign d1 = sd | date: '%-d'
  assign d2 = ed | date: '%-d'
  assign mony = sd | date: '%B %Y'
  if ed != sd and d2 != d1
    assign dates_disp = d1 | append: '-' | append: d2 | append: ' ' | append: mony
  else
    assign dates_disp = sd | date: '%-d %B %Y'
  endif
  assign has_image = false
  if ex.image.value != blank
    assign has_image = true
  endif
-%}

<div class="misc-event">
  <div class="misc-event__top">
    <a class="misc-event__back" href="{{ pages.journal.url }}">Back to Journal</a>
    <span class="misc-event__kicker">Exhibition</span>
  </div>

  <div class="misc-event__cols{% unless has_image %} misc-event__cols--noimg{% endunless %}">
    <div class="misc-event__info">
      <div class="misc-event__crumb">Home / Journal / {{ ex.fair.value }}</div>
      <h1 class="misc-event__title">{{ ex.fair.value }}
        {%- if status == 'now' -%}<span class="misc-pill misc-pill--now">On now</span>
        {%- elsif status == 'past' -%}<span class="misc-pill misc-pill--past">Past</span>
        {%- else -%}<span class="misc-pill misc-pill--upcoming">Upcoming</span>{%- endif -%}
      </h1>

      <div class="misc-event__facts">
        <div class="misc-event__fact"><span class="misc-event__fact-k">When</span><span class="misc-event__fact-v">{{ dates_disp }}</span></div>
        {%- if ex.location.value != blank -%}<div class="misc-event__fact"><span class="misc-event__fact-k">Where</span><span class="misc-event__fact-v">{{ ex.location.value }}</span></div>{%- endif -%}
        {%- if ex.booth.value != blank -%}<div class="misc-event__fact"><span class="misc-event__fact-k">Stand / Booth</span><span class="misc-event__fact-v">{{ ex.booth.value }}</span></div>{%- endif -%}
        <div class="misc-event__fact"><span class="misc-event__fact-k">Status</span><span class="misc-event__fact-v">{% if status == 'past' %}Finished{% else %}Confirmed{% endif %}</span></div>
      </div>

      {%- assign links_raw = ex.links.value -%}
      {%- if links_raw != blank -%}
        <div class="misc-event__cta">
          {%- assign lines = links_raw | strip | split: '
' -%}
          {%- for line in lines -%}
            {%- assign parts = line | split: '|' -%}
            {%- assign label = parts.first | strip -%}
            {%- assign url = parts.last | strip -%}
            {%- if label != blank and url != blank -%}
              <a class="misc-btn{% if forloop.first %} misc-btn--solid{% endif %}" href="{{ url }}">{{ label }}</a>
            {%- endif -%}
          {%- endfor -%}
          {%- unless status == 'past' -%}<a class="misc-btn" href="#">Add to calendar</a>{%- endunless -%}
        </div>
      {%- endif -%}

      {%- if ex.description.value != blank -%}
        <div class="misc-event__body">{{ ex.description }}</div>
      {%- endif -%}
    </div>

    {%- if has_image -%}
      <div class="misc-event__media">
        <img src="{{ ex.image.value | image_url: width: 1200 }}" alt="{{ ex.fair.value | escape }}" loading="lazy" width="1200">
        <div class="misc-event__cap">Image · {{ ex.fair.value }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{ "name": "MISC Exhibition", "settings": [] }
{% endschema %}
