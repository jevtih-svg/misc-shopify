{%- comment -%}
  MISC password / "opening soon" page
  Created: 2026-05-31  ·  Reworked: 2026-05-31 (blocks + spacing fix)

  Full branded opening-soon screen for the MISC Distribution trade store
  while it is password-locked. Used as the `main` section of
  templates/password.json (replaces Trade's email-signup-banner).

  Editor-friendly: every piece of copy is a BLOCK, so it can be edited,
  reordered, added or removed from the Shopify theme editor (Online Store
  -> Customize -> select the Password page -> click the section).

  Layout: separators are block borders, NOT <hr>, because Trade's
  section-password.css forces `hr { margin: 0 !important }`, which was
  collapsing all vertical spacing.

  No Trade core Liquid/CSS edited. assets/misc-password.css hides Trade's
  default password header + footer so this section is the whole screen.
{%- endcomment -%}

{{ 'misc-password.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign maxw = 600
  case section.settings.column_width
    when 'narrow'
      assign maxw = 460
    when 'wide'
      assign maxw = 780
  endcase
  assign align = section.settings.content_align | default: 'left'
-%}

<div
  class="misc-pw color-{{ section.settings.color_scheme }} misc-pw--align-{{ align }}"
  style="--misc-pw-maxw: {{ maxw }}px; --misc-pw-gap: {{ section.settings.block_spacing | default: 48 }}px; --misc-pw-logo-w: {{ section.settings.logo_max_width | default: 130 }}px;"
>
  <div class="misc-pw__inner">

    {%- comment -%} Brand (logo or wordmark) — always at top {%- endcomment -%}
    <div class="misc-pw__brand">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'misc-pw__logo-img',
            widths: '120, 180, 240, 300, 400, 600',
            alt: logo_alt,
            loading: 'eager'
        }}
      {%- else -%}
        <span class="misc-pw__wordmark">{{ section.settings.wordmark | default: 'MISC.' }}</span>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="misc-pw__block misc-pw__block--{{ block.type }}" {{ block.shopify_attributes }}>
        {%- case block.type -%}

          {%- when 'eyebrow' -%}
            {%- if block.settings.text != blank -%}
              <p class="misc-pw__eyebrow">{{ block.settings.text }}</p>
            {%- endif -%}

          {%- when 'heading' -%}
            <h1 class="misc-pw__headline">{{ block.settings.text | default: 'Distributing design stationery across Europe.' }}</h1>

          {%- when 'text' -%}
            <div class="misc-pw__lede">{{ block.settings.text }}</div>

          {%- when 'password' -%}
            {%- if block.settings.label != blank -%}
              <h2 class="misc-pw__label">{{ block.settings.label }}</h2>
            {%- endif -%}
            {%- form 'storefront_password', class: 'misc-pw__form' -%}
              <label class="misc-pw__sr" for="misc-pw-password">Store password</label>
              <div class="misc-pw__inputrow{% if form.errors %} misc-pw__inputrow--error{% endif %}">
                <input
                  type="password"
                  name="password"
                  id="misc-pw-password"
                  class="misc-pw__input"
                  autocomplete="current-password"
                  placeholder="{{ block.settings.placeholder | default: 'Store password' | escape }}"
                  {% if form.errors %}aria-invalid="true" aria-describedby="misc-pw-password-error"{% endif %}
                >
                <button type="submit" name="commit" class="misc-pw__btn misc-pw__btn--solid">
                  {{ block.settings.button | default: 'Enter' }}
                </button>
              </div>
              {%- if form.errors -%}
                <p class="misc-pw__msg misc-pw__msg--error" id="misc-pw-password-error" role="status">
                  {{ block.settings.error | default: 'That password is not correct. Please try again.' }}
                </p>
              {%- endif -%}
            {%- endform -%}
            {%- if block.settings.help != blank -%}
              <p class="misc-pw__help">{{ block.settings.help }}</p>
            {%- endif -%}

          {%- when 'email' -%}
            {%- if block.settings.label != blank -%}
              <h2 class="misc-pw__label">{{ block.settings.label }}</h2>
            {%- endif -%}
            {%- form 'customer', class: 'misc-pw__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter, opening-soon">
              {%- if form.posted_successfully? -%}
                <p class="misc-pw__msg misc-pw__msg--ok" role="status">{{ block.settings.success | default: 'Thank you. We will let you know when the store opens.' }}</p>
              {%- else -%}
                <label class="misc-pw__sr" for="misc-pw-email">Email address</label>
                <div class="misc-pw__inputrow{% if form.errors %} misc-pw__inputrow--error{% endif %}">
                  <input
                    type="email"
                    name="contact[email]"
                    id="misc-pw-email"
                    class="misc-pw__input"
                    autocomplete="email"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder="{{ block.settings.placeholder | default: 'you@company.com' | escape }}"
                    required
                    {% if form.errors %}aria-invalid="true" aria-describedby="misc-pw-email-error"{% endif %}
                  >
                  <button type="submit" name="commit" class="misc-pw__btn misc-pw__btn--outline">
                    {{ block.settings.button | default: 'Subscribe' }}
                  </button>
                </div>
                {%- if form.errors -%}
                  <p class="misc-pw__msg misc-pw__msg--error" id="misc-pw-email-error" role="status">
                    {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                  </p>
                {%- endif -%}
              {%- endif -%}
            {%- endform -%}
            {%- if block.settings.help != blank -%}
              <p class="misc-pw__help">{{ block.settings.help }}</p>
            {%- endif -%}

          {%- when 'contact' -%}
            <div class="misc-pw__meta">
              {%- if block.settings.stamp_value_left != blank -%}
                <div class="misc-pw__stamp">
                  <span class="misc-pw__stamp-label">{{ block.settings.stamp_label_left }}</span>
                  <span class="misc-pw__stamp-value">{{ block.settings.stamp_value_left }}</span>
                </div>
              {%- endif -%}
              {%- if block.settings.stamp_value_right != blank -%}
                <div class="misc-pw__stamp">
                  <span class="misc-pw__stamp-label">{{ block.settings.stamp_label_right }}</span>
                  <span class="misc-pw__stamp-value">{{ block.settings.stamp_value_right }}</span>
                </div>
              {%- endif -%}
              <div class="misc-pw__contact">
                {%- if block.settings.contact_email != blank -%}
                  <a class="misc-pw__contact-link" href="mailto:{{ block.settings.contact_email }}">{{ block.settings.contact_email }}</a>
                {%- endif -%}
                {%- if block.settings.instagram_handle != blank -%}
                  <a class="misc-pw__contact-link" href="{{ block.settings.instagram_url | default: 'https://instagram.com/misc.distribution' }}" target="_blank" rel="noopener">{{ block.settings.instagram_handle }}</a>
                {%- endif -%}
              </div>
            </div>

        {%- endcase -%}
      </div>
    {%- endfor -%}

  </div>
</div>

{% schema %}
{
  "name": "MISC password page",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "paragraph",
      "content": "The logo comes from Settings → Logo. If no logo is set, the wordmark below is shown instead."
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark (logo fallback)",
      "default": "MISC."
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 80,
      "max": 280,
      "step": 5,
      "unit": "px",
      "label": "Logo width",
      "default": 130
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "column_width",
      "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "medium", "label": "Medium" },
        { "value": "wide", "label": "Wide" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "block_spacing",
      "min": 24,
      "max": 88,
      "step": 4,
      "unit": "px",
      "label": "Spacing between blocks",
      "default": 48
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Trade store · Opening soon"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Headline",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Headline",
          "default": "Distributing design stationery across Europe."
        }
      ]
    },
    {
      "type": "text",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>MISC is a wholesale distributor of premium Japanese and European design stationery, supplying independent retailers across the EU.</p>"
        }
      ]
    },
    {
      "type": "password",
      "name": "Password entry",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Section label", "default": "Enter store" },
        { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Store password" },
        { "type": "text", "id": "button", "label": "Button label", "default": "Enter" },
        { "type": "text", "id": "help", "label": "Helper text", "default": "For existing trade partners and preview access." },
        { "type": "text", "id": "error", "label": "Wrong-password message", "default": "That password is not correct. Please try again." }
      ]
    },
    {
      "type": "email",
      "name": "Email signup",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Section label", "default": "Notify me at launch" },
        { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "you@company.com" },
        { "type": "text", "id": "button", "label": "Button label", "default": "Subscribe" },
        { "type": "text", "id": "help", "label": "Helper text", "default": "Be the first to know when the trade store opens." },
        { "type": "text", "id": "success", "label": "Success message", "default": "Thank you. We will let you know when the store opens." }
      ]
    },
    {
      "type": "contact",
      "name": "Contact / footer",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "stamp_label_left", "label": "Stamp label (left)", "default": "Based in" },
        { "type": "text", "id": "stamp_value_left", "label": "Stamp value (left)", "default": "Amsterdam · NL" },
        { "type": "text", "id": "stamp_label_right", "label": "Stamp label (right)", "default": "Since" },
        { "type": "text", "id": "stamp_value_right", "label": "Stamp value (right)", "default": "2010" },
        { "type": "text", "id": "contact_email", "label": "Contact email", "default": "hello@misc-distribution.com" },
        { "type": "text", "id": "instagram_handle", "label": "Instagram handle", "default": "@misc.distribution" },
        { "type": "url", "id": "instagram_url", "label": "Instagram URL" }
      ]
    }
  ]
}
{% endschema %}
