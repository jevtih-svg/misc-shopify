{%- comment -%}
  MISC — exhibition sidebar item (Journal page "Where to find us").
  Inputs:
    ex     : an `exhibition` metaobject
    status : 'now' | 'upcoming' | 'past'
{%- endcomment -%}
{%- liquid
  assign sd = ex.start_date.value
  assign ed = ex.end_date.value | default: sd
  assign d1 = sd | date: '%-d'
  assign d2 = ed | date: '%-d'
  assign mon = sd | date: '%b' | upcase
  assign yr = sd | date: '%Y'
  assign days = d1
  if ed != sd and d2 != d1
    assign days = d1 | append: '-' | append: d2
  endif
-%}
<a class="misc-exh-item{% if status == 'past' %} misc-exh-item--past{% endif %}" href="{{ ex.system.url }}">
  <span class="misc-exh-item__top">
    <span class="misc-exh-item__date">{{ days }} {{ mon }} {{ yr }}</span>
    {%- if status == 'now' -%}<span class="misc-pill misc-pill--now">On now</span>
    {%- elsif status == 'past' -%}<span class="misc-pill misc-pill--past">Past</span>
    {%- else -%}<span class="misc-pill misc-pill--upcoming">Upcoming</span>{%- endif -%}
  </span>
  <span class="misc-exh-item__name">{{ ex.fair.value }}</span>
  <span class="misc-exh-item__meta">{{ ex.location.value }} · {{ ex.booth.value }}</span>
</a>
