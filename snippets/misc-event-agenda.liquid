{%- comment -%}
  MISC — compact event row for the Journal "Where to find us" sidebar.
  Inputs: ex (an `event` metaobject), past (boolean)
{%- endcomment -%}
{%- liquid
  assign sd = ex.start_date.value
  assign ed = ex.end_date.value | default: sd
  assign d1 = sd | date: '%-d'
  assign d2 = ed | date: '%-d'
  assign mon = sd | date: '%b' | upcase
  assign yr = sd | date: '%Y'
  assign days = d1
  if ed != sd and d2 != d1
    assign days = d1 | append: '–' | append: d2
  endif
  assign meta = ex.location.value
  if ex.booth.value != blank
    assign meta = meta | append: ' · ' | append: ex.booth.value
  endif
-%}
<a class="ag{% if past %} ag--past{% endif %}" href="{{ ex.system.url }}">
  <span class="ag__date">{{ days }} {{ mon }} {{ yr }}</span>
  <span class="ag__fair">{{ ex.title.value }}</span>
  <span class="ag__meta">{{ meta }}</span>
</a>
